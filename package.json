{
  "name": "hugo-fe-project",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:integrity": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/node-aliases.mjs --test \"tests/integrity/**/*.test.ts\"",
    "test:e2e": "node --env-file-if-exists=.env.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/node-aliases.mjs --test --test-concurrency=1 \"tests/e2e/**/*.test.ts\"",
    "test:pr3": "npm run lint && npm run typecheck && npm run build && npm run test:integrity && npm run test:e2e",
    "test:pr4": "npm run lint && npm run typecheck && npm run build && npm run test:integrity && npm run test:e2e"
  },
  "dependencies": {
    "next": "^16.4.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
